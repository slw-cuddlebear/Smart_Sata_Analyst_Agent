# ========== DeepSeek LLM ==========
DEEPSEEK_API_KEY=sk-请自行配置key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== 数据库 ==========
DB_TYPE=sqlite
DB_PATH=./data/sample.db

# MySQL 备用配置（DB_TYPE=mysql 时生效）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=密码
MYSQL_DATABASE=demo

# ========== LangSmith 追踪 ==========
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=请自行配置key
LANGSMITH_PROJECT=smart-data-analyst-agent
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com   # 新增此行
# 兼容旧变量名
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=请自行配置key（与上一个key相同）
LANGCHAIN_PROJECT=smart-data-analyst-agent
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com   # 新增此行

# ========== 应用 ==========
OUTPUT_DIR=./outputs